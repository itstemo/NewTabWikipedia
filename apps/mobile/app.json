{
  "expo": {
    "name": "Wikipedia New Tab",
    "slug": "wikipedia-new-tab",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "wikipedia-newtab",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.temo.wikipedia.newtab"
    },
    "android": {
      "package": "com.temo.wikipedia.newtab",
      "adaptiveIcon": {
        "backgroundColor": "#F5F4F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "WikipediaWidget",
              "contentMarginsDisabled": true,
              "displayName": "Random Wikipedia",
              "description": "A random Wikipedia article on your Home Screen.",
              "supportedFamilies": ["systemSmall", "systemMedium"]
            }
          ]
        }
      ]
    ]
  }
}
