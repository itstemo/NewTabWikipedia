{
  "manifest_version": 3,
  "name": "Wikipedia New Tab",
  "version": "2.0.0",
  "description": "Every new tab is one page from the encyclopedia.",
  "author": "Oliver, Jose, Temo",
  "minimum_chrome_version": "108",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": { "newtab": "newtab.html" }
}
